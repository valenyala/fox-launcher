<?xml version="1.0" encoding="utf-8"?>
<!-- The RAM gauge app widget's ring (task 5.5): a determinate ProgressBar drawn as a ring, so RemoteViews can show it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="2.8"
            android:shape="ring"
            android:thicknessRatio="11"
            android:useLevel="false">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="270">
            <shape
                android:innerRadiusRatio="2.8"
                android:shape="ring"
                android:thicknessRatio="11"
                android:useLevel="true">
                <solid android:color="@color/memory_gauge_ring" />
            </shape>
        </rotate>
    </item>
</layer-list>
